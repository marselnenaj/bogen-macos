{
  "name": "@bogen/macos",
  "productName": "Bogen",
  "private": true,
  "version": "0.4.3",
  "description": "Bogen for macOS: the design canvas as a native Mac app",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "fetch-runtime": "node scripts/fetch-runtime.mjs",
    "package": "node scripts/package.mjs",
    "notarize": "node scripts/notarize.mjs",
    "dmg": "node scripts/make-dmg.mjs",
    "update-artifacts": "node scripts/make-update.mjs",
    "release": "node scripts/release.mjs",
    "publish-update": "node scripts/publish-update.mjs",
    "verify": "node scripts/verify-app.mjs",
    "start": "node scripts/build.mjs && electron ."
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/notarize": "3.1.2",
    "@electron/osx-sign": "2.7.2",
    "@electron/packager": "20.3.0",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    }
  }
}

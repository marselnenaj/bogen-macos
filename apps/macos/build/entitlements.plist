<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The entitlements of Bogen's payload (the bundled node, the headless shell, esbuild) and Electron's frameworks.
  Hardened runtime blocks writable-and-executable memory; V8 (in Electron, the bundled Node and the headless Chromium)
  needs MAP_JIT for its JIT compiler, and WebAssembly (woff2-encoder in the server) compiles through it too. Nothing
  else: no App Sandbox (Bogen runs the person's own agent CLIs), no library-validation exception, no dyld variables,
  no debugging. Electron's app and helper executables get entitlements-shell.plist: this plus audio input.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
